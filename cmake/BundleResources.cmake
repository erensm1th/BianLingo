# Byte arrays avoid MSVC's string literal length limit and UTF-8 chunk boundaries.
set(bundle_source "${CMAKE_CURRENT_BINARY_DIR}/generated/bundle_data.cpp")
file(WRITE "${bundle_source}" "#include <string_view>\n#include <cstddef>\n#include <stdexcept>\nnamespace bl {\n")
set(bundle_entries "")
set(bundle_index 0)
function(bundle_resource name filename)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${filename}")
  file(READ "${filename}" contents HEX)
  string(LENGTH "${contents}" hex_length)
  math(EXPR size "${hex_length} / 2")
  string(REGEX REPLACE "(..)" "0x\\1," bytes "${contents}")
  file(APPEND "${bundle_source}" "static const unsigned char data_${bundle_index}[] = {${bytes}};\n")
  set(bundle_entries "${bundle_entries}{\"${name}\", data_${bundle_index}, ${size}},\n" PARENT_SCOPE)
  math(EXPR next "${bundle_index} + 1")
  set(bundle_index "${next}" PARENT_SCOPE)
endfunction()
